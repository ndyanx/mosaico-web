# Variables que Vite incrusta AL COMPILAR (en Cloudflare Pages: Settings > Variables and Secrets).
# Cambiarlas exige un nuevo deploy.

# URL del backend (Render), sin barra final. Vacío en local: se usa el proxy /api de Vite.
VITE_API_URL=https://channel-feed-api.onrender.com

# URL publica del sitio, para canonical y la imagen al compartir enlaces. Opcional.
VITE_SITE_URL=https://mosaico.pages.dev
